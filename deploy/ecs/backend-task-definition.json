{
  "family": "new-adv-rag-backend",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "1024",
  "memory": "2048",
  "executionRoleArn": "arn:aws:iam::785282204559:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::785282204559:role/new-adv-rag-backend-task-role",
  "containerDefinitions": [
    {
      "name": "backend",
      "image": "785282204559.dkr.ecr.us-east-2.amazonaws.com/new-adv-rag-backend:v8",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8000,
          "protocol": "tcp"
        }
      ],
      "environment": [
        { "name": "QDRANT_URL", "value": "https://0071b366-6f79-45cc-aa5a-a196e547aad6.sa-east-1-0.aws.cloud.qdrant.io:6333" },
        { "name": "QDRANT_COLLECTION", "value": "new_adv_rag_documents" },
        { "name": "AWS_REGION", "value": "us-east-2" },
        { "name": "STORAGE_BACKEND", "value": "s3" },
        { "name": "S3_CACHE_BUCKET", "value": "new-adv-rag-docs-785282204559" }
      ],
      "secrets": [
        { "name": "DATABASE_URL", "valueFrom": "arn:aws:secretsmanager:us-east-2:785282204559:secret:prod/advrag/backend-tRrMh7:DATABASE_URL::" },
        { "name": "OPENAI_API_KEY", "valueFrom": "arn:aws:secretsmanager:us-east-2:785282204559:secret:prod/advrag/backend-tRrMh7:OPENAI_API_KEY::" },
        { "name": "QDRANT_API_KEY", "valueFrom": "arn:aws:secretsmanager:us-east-2:785282204559:secret:prod/advrag/backend-tRrMh7:QDRANT_API_KEY::" },
        { "name": "JWT_SECRET", "valueFrom": "arn:aws:secretsmanager:us-east-2:785282204559:secret:prod/advrag/backend-tRrMh7:JWT_SECRET::" },
        { "name": "TAVILY_API_KEY", "valueFrom": "arn:aws:secretsmanager:us-east-2:785282204559:secret:prod/advrag/backend-tRrMh7:TAVILY_API_KEY::" },
        { "name": "UPSTASH_REDIS_TOKEN", "valueFrom": "arn:aws:secretsmanager:us-east-2:785282204559:secret:prod/advrag/backend-tRrMh7:UPSTASH_REDIS_TOKEN::" },
        { "name": "UPSTASH_REDIS_URL", "valueFrom": "arn:aws:secretsmanager:us-east-2:785282204559:secret:prod/advrag/backend-tRrMh7:UPSTASH_REDIS_URL::" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/new-adv-rag-backend",
          "awslogs-region": "us-east-2",
          "awslogs-stream-prefix": "ecs"
        }
      },
      "healthCheck": {
        "command": ["CMD-SHELL", "python -c \"import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health').read()\""],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 30
      }
    }
  ]
}
